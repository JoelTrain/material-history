# Default frontend demo; set false when using PostgreSQL.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Generate a unique strong secret: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# PostgreSQL mode settings (set secure values before enabling).
POSTGRES_USER=material_history
POSTGRES_DB=material_history
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
