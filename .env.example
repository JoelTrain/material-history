# Frontend mock mode: true (default). Set false to use PostgreSQL.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Required only for non-demo mode. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# External PostgreSQL: when NEXT_PUBLIC_DEMO_MODE=false, use an actual URI.
# For local Compose PostgreSQL, compose.postgres.yaml sets DATABASE_URL automatically.
DATABASE_URL=postgresql://material_history:replace-me@localhost:5432/material_history

# Local PostgreSQL Compose values. Use unique values in your local .env.
POSTGRES_USER=material_history
POSTGRES_DB=material_history
POSTGRES_PASSWORD=replace-with-a-strong-local-password
